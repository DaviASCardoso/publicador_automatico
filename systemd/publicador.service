[Unit]
Description=Publicador automático de vídeos (YouTube + TikTok)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=publicador
Group=publicador
WorkingDirectory=/opt/publicador
ExecStart=/opt/publicador/.venv/bin/python -m publicador.daemon
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
